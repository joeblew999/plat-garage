# GARAGE Configuration
# Copy to .env: cp .env.example .env

# =============================================================================
# Local (works out of the box)
# =============================================================================
PBHA_URL=http://localhost:8090
PBHA_ADMIN_EMAIL=admin@garage.local
PBHA_ADMIN_PASS=admin123456

# =============================================================================
# Cloudflare (xplat sync-cf compatible)
# =============================================================================
# Run: xplat task url:r2:tokens to open Cloudflare dashboard

CF_ACCOUNT_ID=
CF_API_TOKEN=

# R2 bucket credentials (Object Read & Write permission)
R2_BUCKET=garage
R2_ACCESS_KEY=
R2_SECRET_KEY=

# =============================================================================
# Backblaze B2 (optional - cold archive)
# =============================================================================
#B2_ACCOUNT=
#B2_KEY=
#B2_BUCKET=garage-archive
